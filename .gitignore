# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
.venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# pytest
.pytest_cache/

# GitStone / gitstone-ui output: recovered target repositories and the
# web UI's workspace must never land in *this* project's own history.
# These are bare patterns (no leading slash), so they match at any depth --
# `dump/` matches Docker-Packages/docker-compose.yml's default bind mount
# (Docker-Packages/dump); `workspace/` and `.gitstone/` match likely local
# --workspace choices when testing the UI from a checkout (e.g. from inside
# GitStone-Packages/, where `cd GitStone-Packages && python3 -m
# gitstone_webui --workspace ./workspace` would land).
dump/
workspace/
.gitstone/

# In-progress atomic downloads (gitstone.py writes these, then renames)
*.part

# Client certificates (--client-cert-p12) if one ends up dropped here for
# local testing -- these are credentials, never meant to be committed.
*.p12
*.pfx

# OS cruft
.DS_Store
Thumbs.db
