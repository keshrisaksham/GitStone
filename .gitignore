# GitStone output: recovered target repositories and the web UI's workspace
# must never land in this project's own history. Bare patterns match at any
# depth, so `dump/` also covers the folder the Docker examples bind-mount.
dump/
workspace/
.gitstone/

# In-progress atomic downloads (the dumper writes these, then renames)
*.part

# Client certificates (--client-cert-p12) dropped here for local testing:
# credentials, never meant to be committed.
*.p12
*.pfx

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
